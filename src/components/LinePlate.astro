---
// Illustrazione generata: un groviglio di linee che si ordina in un fascio.
// Stesso seed, stesso disegno: ogni articolo o pagina ha la sua variante stabile.
interface Props {
  seed: string;
  vertical?: boolean;
  draw?: boolean;
  class?: string;
}

const { seed, vertical = false, draw = false, class: className = '' } = Astro.props;

function hash(text: string) {
  let h = 2166136261;
  for (const char of text) h = Math.imul(h ^ char.charCodeAt(0), 16777619);
  return h >>> 0;
}

function rng(start: number) {
  let a = start;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1000;
const H = 600;
const STRANDS = 26;
const POINTS = 44;
const rand = rng(hash(seed));
const accent = Math.floor(rand() * STRANDS);

const strands = Array.from({ length: STRANDS }, (_, i) => {
  const target = H * (0.08 + (0.84 * i) / (STRANDS - 1));
  const waves = Array.from({ length: 3 }, () => ({
    amp: 60 + rand() * 170,
    freq: 2 + rand() * 7,
    phase: rand() * Math.PI * 2,
  }));
  const points = Array.from({ length: POINTS + 1 }, (_, p) => {
    const t = p / POINTS;
    const disorder = Math.pow(Math.max(0, 1 - t * 1.35), 2);
    const noise = waves.reduce((sum, w) => sum + w.amp * Math.sin(w.freq * t * Math.PI + w.phase), 0);
    const x = t * W;
    const y = Math.min(H, Math.max(0, target + noise * disorder));
    return vertical ? `${((y / H) * W).toFixed(1)} ${((x / W) * H).toFixed(1)}` : `${x.toFixed(1)} ${y.toFixed(1)}`;
  });
  return { d: `M${points.join(' L')}`, isAccent: i === accent, delay: i * 40 };
});
---

<svg class:list={['line-plate', { 'line-plate--draw': draw }, className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" fill="none" aria-hidden="true">
  {strands.map((s) => (
    <path d={s.d} pathLength="1" class={s.isAccent ? 'lp-accent' : ''} style={`--d:${s.delay}ms`} />
  ))}
</svg>
