---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import LinePlate from '../components/LinePlate.astro';
import PrivacyNote from '../components/PrivacyNote.astro';
import Venn from '../components/Venn.astro';

// Dario Saramin temporaneamente escluso dal team pubblico — richiesta di Edoardo, 8 luglio 2026.
// Per ripristinarlo: riaggiungere qui il suo oggetto (nome, ruolo, bio, foto, linkedin).
const levels = [
  { name: 'Strategia', desc: 'Dove state andando, e come farete a saperlo. La north star con i suoi OKR.' },
  { name: 'Processi', desc: 'Chi decide cosa, senza chiederlo ogni volta. Ruoli, criteri e punti di decisione espliciti.' },
  { name: 'Dati', desc: 'I numeri veri in un posto solo di cui ci si fida. I KPI che contano, non cinque Excel che non tornano.' },
  { name: 'Growth', desc: 'Si spinge dove i dati dicono di spingere. CAC, funnel, budget decisi sui numeri.' },
];

const teamMembers = [
  {
    name: 'Edoardo Marcis',
    role: 'Strategia & growth',
    bio: 'Fractional COO e consulente strategico: aiuta PMI e scale-up a crescere senza perdere il controllo. Dall\'idea alla messa a terra, passando per sistemi, governance e OKR. Lettore compulsivo, meditatore. Lo trovi in un surf spot o sul tatami a fare jiu-jitsu.',
    image: '/images/team/edoardo.jpg',
    linkedin: 'https://linkedin.com/in/edoardomarcis',
  },
  {
    name: 'Andrea Cavaliere',
    role: 'Performance & facilitazione',
    bio: 'Oltre 3M€ di budget adv gestiti multi-piattaforma. OKR coach, facilitatore certificato LEGO® Serious Play. Fotografo, videomaker, papà di un border collie.',
    image: '/images/team/andrea.jpg',
    linkedin: 'https://www.linkedin.com/in/andreacavaliere-/',
  },
];
---

<Base
  title="Chi siamo · Strategica"
  description="Due professionisti senior con background complementari, strategia e performance marketing. Non un'agenzia, non una società di consulenza: quello che mancava."
  activePage="chi-siamo"
>

<!-- ── HERO ─────────────────────────────────────────────────────────── -->
<section class="page-hero t-ink">
  <div class="section-label"><span style="grid-column: 2 / span 8;">Chi siamo</span></div>
  <div>
    <h1>
      Non un'agenzia. Non una società di consulenza.
      <em>Siamo quello che mancava.</em>
    </h1>
    <p class="page-hero-sub">
      Due professionisti senior con background complementari, strategia e performance marketing. Stessa insofferenza per il pressapochismo, stessa idea di cosa significhi fare consulenza davvero.
    </p>
  </div>
  <LinePlate seed="chi-siamo" vertical draw class="page-hero-plate" />
</section>

<!-- ── MANIFESTO ─────────────────────────────────────────────────────── -->
<section class="sec t-cream">
  <div class="section-label"><span style="grid-column: 2 / span 8;">Il manifesto</span></div>
  <div class="cs-manifesto-list">

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">Siamo stanchi del pressapochismo.</p>
      <p class="cs-block-body">Abbiamo lavorato in startup, in multinazionali, in agenzie. Ovunque la stessa scena: tanta esecuzione, poca strategia. Tante slide, pochi risultati. Strategica nasce da lì: dalla decisione di fare le cose in modo diverso.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">La consulenza non è un deliverable. È un risultato.</p>
      <p class="cs-block-body">Non misuriamo il nostro valore in ore fatturate o slide consegnate. Lo misuriamo in governance funzionante, processi decisionali chiari, organizzazione che scala in autonomia. Se il cliente non ottiene risultati concreti, abbiamo fallito noi.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">Senza compromessi.</p>
      <p class="cs-block-body">Non facciamo body rental. Non vendiamo quello che non ti serve. Non gonfiamo progetti per fatturare. Analizziamo il tuo problema finché non capiamo cosa serve davvero. Disegniamo la strada migliore, anche se non è quella che prescrive il framework. La consulenza ben fatta serve il cliente, non il nostro fatturato.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">Non solo processo.</p>
      <p class="cs-block-body">Disegniamo governance, processi decisionali e allineamento dell'organizzazione. Perché scalare non è solo eseguire: è decidere insieme, misurare cosa conta, comunicare in modo allineato.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">
        Il nostro obiettivo è
        <em><Mark color="coral" viewBox="0 0 220 14" path="M2 10 C40 5, 90 13, 140 8 C175 5, 205 11, 218 8">diventare inutili.</Mark></em>
      </p>
      <p class="cs-block-body">Non creiamo dipendenza. Trasformiamo governance, processi e organizzazione in modo che funzionino in autonomia. La vera misura è se il modello operativo continua a evolversi anche dopo il nostro intervento.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">Background diversi. Stessa insofferenza.</p>
      <p class="cs-block-body">Veniamo da startup, big four, performance marketing, innovazione digitale. Ci siamo riconosciuti nello stesso gap: la consulenza promette molto e produce poco. Strategica è la nostra risposta.</p>
    </div>

    <div class="cs-block grid g-fade">
      <p class="cs-block-phrase">Due mestieri che quasi nessuno tiene insieme.</p>
      <p class="cs-block-body">Strategia da una parte, performance marketing dall'altra. I consulenti strategici si fermano al documento e non sanno misurare l'acquisizione; le agenzie partono dal canale e non rimettono in discussione la strategia. Noi chiudiamo il cerchio: la direzione, e i numeri che dicono se sta funzionando.</p>
    </div>
  </div>
</section>

<!-- ── COME RAGIONIAMO ───────────────────────────────────────────────── -->
<section class="sec approach t-warm" id="come-ragioniamo">
  <div class="section-label"><span style="grid-column: 2 / span 7;">Come ragioniamo</span><span class="folio-r">Tav. 02</span></div>
  <div class="grid">
    <div class="approach-head g-fade">
      <h2>Quattro livelli, in quest'ordine.</h2>
    </div>
    <p class="approach-lead g-fade">Una cascata, dove ogni livello regge solo se regge quello sotto.</p>
  </div>
  <figure class="tavola">
    <ol class="cascade">
      {levels.map((level, i) => (
        <li class="g-fade" style={`--i:${i}`}>
          <div class="step-num">0{i + 1}</div>
          <h3>{level.name}</h3>
          <p class="step-desc">{level.desc}</p>
        </li>
      ))}
    </ol>
    <figcaption class="tavola-cap"><span>Tav. 02 · La cascata</span></figcaption>
  </figure>
  <div class="grid approach-method">
    <p class="approach-pull g-fade">La growth senza metriche è spendere a caso, le metriche senza processi non sono affidabili, i processi senza strategia ottimizzano la direzione sbagliata.</p>
    <figure class="tavola approach-venn">
      <Venn />
      <figcaption class="tavola-cap"><span>Tav. 03 · Il metodo</span></figcaption>
    </figure>
  </div>
</section>

<!-- ── TEAM ──────────────────────────────────────────────────────────── -->
<section class="sec t-ink">
  <div class="section-label"><span style="grid-column: 2 / span 8;">Le persone</span></div>
  <h2 class="cs-team-h g-fade">Facce, non loghi.</h2>

  <div>
    {teamMembers.map((member) => (
      <article class="tc-card grid">
        <div class="tc-photo">
          <img class="tc-img" src={member.image} alt={`Foto di ${member.name}`} loading="lazy" draggable="false" />
        </div>
        <div class="tc-info">
          <span class="tc-role">{member.role}</span>
          <strong class="tc-name">{member.name}</strong>
          <p class="tc-bio">{member.bio}</p>
          <a href={member.linkedin} class="btn-ghost" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn di ${member.name}`}>LinkedIn</a>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- ── CTA ───────────────────────────────────────────────────────────── -->
<section class="sec t-warm">
  <div class="section-label"><span style="grid-column: 2 / span 8;">Parliamoci</span></div>
  <div class="grid">
  <div class="cs-cta-left">
    <h2 class="cs-cta-h">
      Se ti riconosci in questo modo di pensare,
      <em>parliamoci.</em>
    </h2>
  </div>
  <div class="cs-cta-right">
    <p>Non servono deck pronti o brief formali. Basta una mail, e capiamo insieme se ha senso parlare.</p>
    <div class="actions">
      <a href="mailto:hello@wearestrategica.com?subject=Vorrei%20parlarne" class="btn-dark">Scrivici →</a>
      <a href="/#approccio" class="btn-ghost">Scopri come lavoriamo</a>
    </div>
    <PrivacyNote />
  </div>
  </div>
</section>


</Base>
