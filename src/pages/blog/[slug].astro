---
import Base from '../../layouts/Base.astro';
import LinePlate from '../../components/LinePlate.astro';
import { article } from '../../utils/jsonld';
import { authors } from '../../utils/authors';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const author = authors[post.data.author];
const jsonLd = article(post);
---

<Base
  title={`${post.data.title} · Strategica`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.coverImage}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  }}
  jsonLd={jsonLd}
>

<article class="post-main">
  <header class="sec t-ink post-header">
    <div class="post-top">
      <a href="/blog">← Blog</a>
      <span>{post.data.pubDate.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    </div>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-desc">{post.data.description}</p>
    {!post.data.coverImage && <div class="post-plate"><LinePlate seed={post.slug} /></div>}
  </header>

  <div class="sec t-warm">
    <div class="grid post-layout">
      <aside class="post-rail">
        <span class="post-author-name">{post.data.author}</span>
        {post.data.tags && post.data.tags.map(tag => (
          <span class="blog-tag">{tag}</span>
        ))}
      </aside>

      <div class="post-col">
        {post.data.coverImage && (
          <img class="post-cover" src={post.data.coverImage} alt={post.data.title} />
        )}

        <div class="post-body">
          <Content />
        </div>

        {author && (
          <aside class="post-author-box">
            <img class="pab-photo" src={author.photo} alt={author.name} width="96" height="96" />
            <div>
              <span class="pab-role">{author.role}</span>
              <strong class="pab-name">{author.name}</strong>
              <p class="pab-bio">{author.bio}</p>
              <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">LinkedIn</a>
            </div>
          </aside>
        )}

        <div class="post-footer actions">
          <a href="/#contatti" class="btn-dark">Parliamone</a>
          <a href="/blog" class="btn-ghost">Tutti gli articoli</a>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
.post-header { padding-top: 16px; }
.post-top { display: flex; justify-content: space-between; gap: 16px; font-size: var(--t-meta); color: var(--fg2); margin-bottom: clamp(48px, 7vw, 112px); }
.post-top a { text-decoration: none; }
.post-top a:hover { color: var(--fg); }
.post-title { font-size: clamp(40px, 5.6vw, 92px); line-height: 0.98; max-width: 16em; }
.post-plate { height: clamp(140px, 22vw, 320px); margin-top: clamp(32px, 4vw, 56px); }
.post-desc { font-size: var(--t-lead); line-height: 1.5; color: var(--fg2); max-width: 34em; margin-top: 32px; }

.post-rail {
  grid-column: 1 / span 3; align-self: start; position: sticky; top: calc(var(--nav-h) + 24px);
  display: flex; flex-direction: column;
  font-size: var(--t-meta); color: var(--fg2);
  border-top: 1px solid var(--line); padding-top: 12px;
}
.post-author-name { color: var(--fg); margin-bottom: 8px; }
.post-col { grid-column: 4 / span 7; }
.post-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; margin-bottom: 48px; }

.post-author-box {
  display: flex; gap: 24px; align-items: flex-start;
  margin-top: 64px; padding-top: 16px;
  border-top: 1px solid var(--fg);
}
.pab-photo { flex-shrink: 0; width: 96px; height: 96px; border-radius: 4px; object-fit: cover; filter: grayscale(100%); }
.pab-role { display: block; font-size: var(--t-meta); color: var(--fg2); }
.pab-name { display: block; font-family: var(--serif); font-weight: 300; font-size: var(--t-h3); line-height: 1.1; letter-spacing: -0.02em; margin: 4px 0 8px; }
.pab-bio { color: var(--fg2); }
.post-footer { margin-top: 48px; }

@media (max-width: 900px) {
  .post-rail, .post-col { grid-column: 1 / -1; }
  .post-rail { position: static; margin-bottom: 32px; flex-direction: row; flex-wrap: wrap; gap: 4px 12px; }
  .post-author-name { margin-bottom: 0; }
}
</style>

</Base>
