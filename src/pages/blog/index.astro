---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import LinePlate from '../../components/LinePlate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const FILTERS = ['Strategia', 'Management', 'AI', 'Crescita'];

const featured = posts[0] ?? null;
const rest = posts.slice(1);

function fmtDate(d: Date) {
  return d.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base
  title="Blog · Strategica"
  description="Riflessioni su strategia, crescita e management per PMI italiane. Articoli pratici per chi vuole capire prima di agire."
  activePage="blog"
>

<!-- ── HEADER dark ────────────────────────────────────────────────────── -->
<header class="page-hero t-ink blog-hero">
  <div class="section-label"><span style="grid-column: 2 / span 8;">Riflessioni</span></div>
  <div>
    <h1>
      Idee scritte per
      <em><Mark color="coral" viewBox="0 0 300 14" path="M2 10 C50 5, 120 13, 190 8 C240 4, 280 11, 298 8">capire prima di agire.</Mark></em>
    </h1>
    <p class="page-hero-sub">Strategia, crescita, management. Senza fretta, senza ovvietà.</p>
  </div>
  <LinePlate seed="blog" vertical draw class="page-hero-plate" />
</header>

<main class="sec t-warm blog-main">
  {posts.length === 0 ? (
    <p class="blog-empty">I primi articoli sono in arrivo.</p>
  ) : (
    <>
      {featured && (
        <a href={`/blog/${featured.slug}`} class="blog-featured" data-tags={(featured.data.tags ?? []).join(',')}>
          <div class="blog-meta">
            <span>Ultimo articolo</span>
            <span>{fmtDate(featured.data.pubDate)}</span>
          </div>
          <div class="blog-cover blog-cover--wide t-ink">
            {featured.data.coverImage ? <img src={featured.data.coverImage} alt="" /> : <LinePlate seed={featured.slug} />}
          </div>
          <h2>{featured.data.title}</h2>
          <div class="grid">
            <p class="blog-featured-desc">{featured.data.description}</p>
            <span class="btn-ghost blog-featured-cta">Leggi l'articolo</span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="blog-filters" id="blog-filters" role="group" aria-label="Filtra per argomento">
          <button class="filter-btn filter-btn--active" data-tag="tutti">Tutti</button>
          {FILTERS.map(tag => (
            <button class="filter-btn" data-tag={tag}>{tag}</button>
          ))}
        </div>
      )}

      {rest.length > 0 && (
        <div class="blog-grid" id="blog-grid">
          {rest.map((post) => (
            <a href={`/blog/${post.slug}`} class="blog-card" data-tags={(post.data.tags ?? []).join(',')}>
              <div class="blog-cover t-ink">
                {post.data.coverImage ? <img src={post.data.coverImage} alt="" loading="lazy" /> : <LinePlate seed={post.slug} />}
              </div>
              <div class="blog-card-meta">
                <span>{fmtDate(post.data.pubDate)}</span>
                <span>{(post.data.tags ?? []).slice(0, 2).join(' · ')}</span>
              </div>
              <h3 class="blog-card-title">{post.data.title}</h3>
              <p class="blog-card-desc">{post.data.description}</p>
            </a>
          ))}
        </div>
      )}

      <p class="blog-empty" id="blog-empty-filter" style="display:none">
        Nessun articolo in questa categoria.
      </p>
    </>
  )}
</main>

<script>import '../../scripts/blog-filters';</script>

<style>
.blog-hero { min-height: min(56svh, 600px); }
.blog-main { padding-top: 32px; }
.blog-empty { color: var(--fg2); margin-top: 32px; }

.blog-featured { display: block; text-decoration: none; padding-bottom: clamp(64px, 8vw, 128px); }
.blog-meta { display: flex; justify-content: space-between; gap: 16px; font-size: var(--t-meta); color: var(--fg2); margin-bottom: clamp(32px, 4vw, 64px); }
.blog-featured h2 { font-size: clamp(40px, 5.6vw, 88px); line-height: 0.98; max-width: 16em; margin-bottom: 24px; transition: color .2s; }
.blog-featured:hover h2 { color: var(--accent); }
.blog-featured-desc { grid-column: 1 / span 6; font-size: var(--t-lead); line-height: 1.5; color: var(--fg2); }
.blog-featured-cta { grid-column: 8 / -1; justify-self: end; align-self: end; }

.blog-filters { display: flex; flex-wrap: wrap; gap: 4px 24px; border-top: 1px solid var(--fg); padding-top: 4px; }
.filter-btn {
  min-height: 44px;
  font: inherit; font-size: var(--t-small);
  background: none; border: none; cursor: pointer;
  color: var(--fg2);
  transition: color .2s;
}
.filter-btn:hover { color: var(--fg); }
.filter-btn--active { color: var(--fg); text-decoration: underline; text-decoration-color: var(--terra); text-underline-offset: 6px; }

.blog-cover { aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; padding: 0; }
.blog-cover--wide { aspect-ratio: 21 / 8; margin-bottom: 32px; }
.blog-cover img { width: 100%; height: 100%; object-fit: cover; }
.blog-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(40px, 5vw, 72px) var(--col-gap); margin-top: 32px;
}
.blog-card { display: block; text-decoration: none; }
.blog-card-meta { display: flex; justify-content: space-between; gap: 12px; margin: 12px 0 10px; font-size: var(--t-meta); color: var(--fg2); }
.blog-card-title { font-size: clamp(26px, 2.2vw, 34px); line-height: 1.04; margin-bottom: 10px; transition: color .2s; }
.blog-card:hover .blog-card-title { color: var(--accent); }
.blog-card-desc { font-size: var(--t-small); line-height: 1.5; color: var(--fg2); }

@media (max-width: 1000px) { .blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 800px) {
  .blog-featured-desc, .blog-featured-cta { grid-column: 1 / -1; justify-self: start; }
  .blog-cover--wide { aspect-ratio: 4 / 3; }
}
@media (max-width: 600px) { .blog-grid { grid-template-columns: 1fr; } }
</style>

</Base>
